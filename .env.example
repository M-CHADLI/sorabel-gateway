# --- Génération (chat) : déjà en service ---------------------------------------------
# L'endpoint peut être donné avec ou sans le suffixe /openai/v1, le code normalise.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME est accepté comme alias.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Embeddings : nom du déploiement, pas le nom du modèle du catalogue ----------------
# Remplace le modèle local intfloat/multilingual-e5-base.
# Changer ce déploiement impose de réindexer tout le corpus (vecteurs non mélangeables).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Reranking ------------------------------------------------------------------------
# Remplace le modèle local BAAI/bge-reranker-v2-m3.
# Changer ce déploiement impose de recalibrer le seuil de refus hors corpus (E1).
AZURE_OPENAI_RERANK_DEPLOYMENT=

# --- Surcharges facultatives ----------------------------------------------------------
# Les modèles non-OpenAI (Cohere, Mistral…) sont parfois déployés en « serverless » sur un
# endpoint et une clé distincts de la ressource Azure OpenAI. Ne renseigner que dans ce
# cas : à défaut, les valeurs AZURE_OPENAI_* ci-dessus sont réutilisées.
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
AZURE_RERANK_ENDPOINT=
AZURE_RERANK_API_KEY=
